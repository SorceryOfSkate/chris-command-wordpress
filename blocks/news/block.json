{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chris-command/news",
  "version": "0.2.0",
  "title": "Chris Command News",
  "category": "widgets",
  "icon": "rss",
  "description": "Display a live, server-rendered Chris Command News category.",
  "textdomain": "chris-command",
  "attributes": {
    "category": {
      "type": "string",
      "default": "tech"
    },
    "limit": {
      "type": "number",
      "default": 5
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
